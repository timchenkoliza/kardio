{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceSpec",
  "type": "object",
  "required": ["id", "title", "owner", "surface", "slots"],
  "properties": {
    "id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "owner": {"enum": ["system", "user", "ai_suggested"]},
    "surface": {"enum": ["today", "patient", "visit", "evidence", "tools", "followup", "custom"]},
    "specialty": {"type": ["string", "null"]},
    "layout": {
      "type": "object",
      "properties": {
        "density": {"enum": ["compact", "balanced", "spacious"]},
        "columns_desktop": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "module", "size", "pinned"],
        "properties": {
          "id": {"type": "string"},
          "module": {"type": "string"},
          "size": {"enum": ["s", "m", "l", "xl"]},
          "pinned": {"type": "boolean"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "ranking_query": {"type": ["object", "null"]},
          "config": {"type": "object"},
          "reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}
