{
  "name": "kardio-physician-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint app components lib server db scripts tests && node scripts/check-design-tokens.mjs && node scripts/check-product-copy.mjs",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:local": "tsx scripts/local-postgres.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/import-goldenset.ts",
    "db:ontology-seed": "tsx scripts/import-ontology.ts",
    "db:drive-sync": "tsx scripts/sync-drive-inventory.ts",
    "db:verify": "tsx scripts/verify-db.ts",
    "data:validate": "tsx scripts/validate-content.ts",
    "ontology:validate": "tsx scripts/validate-ontology.ts",
    "telegram:inspect": "tsx scripts/inspect-telegram-export.ts",
    "telegram:candidate-sync": "tsx scripts/sync-telegram-candidates.ts",
    "distribution:inspect": "tsx scripts/inspect-distribution-signals.ts",
    "resolution:event-sync": "tsx scripts/sync-event-reference-candidates.ts",
    "resolution:event-inspect": "tsx scripts/inspect-event-pages.ts",
    "resolution:event-context-inspect": "tsx scripts/inspect-event-mention-context.ts",
    "resolution:event-identity-inspect": "tsx scripts/inspect-event-identity-shapes.ts",
    "resolution:event-transport-sync": "tsx scripts/sync-event-reference-transport-groups.ts",
    "resolution:event-role-inspect": "tsx scripts/inspect-event-semantic-roles.ts",
    "resolution:event-calendar-inspect": "tsx scripts/inspect-event-calendar-evidence.ts",
    "resolution:media-inspect": "tsx scripts/inspect-telegram-media-resolution.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run build"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
