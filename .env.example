# Local development only; provision separate credentials for hosted PostgreSQL.
DATABASE_URL=postgresql://kardio:kardio@127.0.0.1:55432/kardio
APP_ORIGIN=http://localhost:3000
SESSION_SECURE=false

# Optional Expert Twins sidecar. Server-side only; never expose as NEXT_PUBLIC_*.
# Example for local deterministic mode: http://127.0.0.1:8088
EXPERT_TWINS_URL=

# Google Drive raw archive ingestion. Never commit a real token.
# The root folder ID is also recorded in data/drive-source-registry.json.
GOOGLE_DRIVE_ARCHIVE_ROOT_ID=1JnLZvA-yab8bkmRrq8juovMS8t4ld6cR
# Modes: google_drive_api | local_mirror
GOOGLE_DRIVE_PROVIDER=local_mirror
# For local_mirror: absolute path to the synced/downloaded kardio-media-source directory.
GOOGLE_DRIVE_LOCAL_MIRROR=
# For google_drive_api: short-lived/read-only OAuth access token or equivalent injected secret.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_SYNC_MAX_DEPTH=4
GOOGLE_DRIVE_SYNC_MAX_ITEMS=20000
