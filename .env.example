# Local development only; provision separate credentials for hosted PostgreSQL.
DATABASE_URL=postgresql://kardio:kardio@127.0.0.1:55432/kardio
APP_ORIGIN=http://localhost:3000
SESSION_SECURE=false

# Optional Expert Twins sidecar. Server-side only; never expose as NEXT_PUBLIC_*.
# Example for local deterministic mode: http://127.0.0.1:8088
EXPERT_TWINS_URL=

# Optional public, rights-approved media CDN/base URL.
# When set, the visualization/media registry resolves approved cardiology assets from this base
# before falling back to attributed open-license teaching media.
# Expected paths include cardiology/anatomy/heart.svg and cardiology/imaging/*.
NEXT_PUBLIC_MEDIA_CLOUD_BASE_URL=

# Google Drive raw archive ingestion. Never commit a real token.
# The root folder ID is also recorded in data/drive-source-registry.json.
GOOGLE_DRIVE_ARCHIVE_ROOT_ID=1JnLZvA-yab8bkmRrq8juovMS8t4ld6cR
# Modes: google_drive_api | local_mirror
GOOGLE_DRIVE_PROVIDER=local_mirror
# For local_mirror: absolute path to the synced/downloaded kardio-media-source directory.
GOOGLE_DRIVE_LOCAL_MIRROR=
# For google_drive_api: short-lived/read-only OAuth access token or equivalent injected secret.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_SYNC_MAX_DEPTH=4
GOOGLE_DRIVE_SYNC_MAX_ITEMS=20000

# Original article media ingestion. The source folders themselves are registered in
# data/article-media-source-registry.json and are never used as production image URLs.
# Yandex Disk token is only needed for private oncology source folders.
YANDEX_DISK_ACCESS_TOKEN=
ARTICLE_MEDIA_SYNC_MAX_DEPTH=1
ARTICLE_MEDIA_SYNC_MAX_ITEMS=10000

# Optional batch renderer for article-specific image-to-GIF jobs.
# Rendering is an offline/editorial pipeline, never a physician-request runtime action.
ARTICLE_MOTION_RENDERER_URL=
ARTICLE_MOTION_RENDERER_TOKEN=

# Agent workspace — PubMed connector (NCBI E-utilities, server-side only).
# Optional key raises the NCBI rate limit; set PUBMED_DISABLED=1 to report the connector as UNAVAILABLE
# (e.g. offline CI). Without DATABASE_URL the agent store falls back to per-instance memory plus an HttpOnly profile cookie (no findings, no materials).
NCBI_API_KEY=
PUBMED_DISABLED=

# Drug labels (openFDA, server-side only). Without a key openFDA allows 1,000 requests/day per IP;
# a free key raises it to 120,000/day. OPENFDA_DISABLED=1 reports the connector as UNAVAILABLE.
OPENFDA_API_KEY=
OPENFDA_DISABLED=

# Browser-capable sources (MEDI). SOURCE_BROWSER=auto|playwright|http|off — auto uses a real
# Chromium when one can start and plain HTTP otherwise (reported as LIMITED, never as LIVE).
# SOURCE_BROWSER_MODULE / SOURCE_BROWSER_EXECUTABLE point at playwright-core / Chromium when they
# are not resolvable from the server bundle. MEDI_DISABLED=1 reports MEDI as UNAVAILABLE.
SOURCE_BROWSER=auto
SOURCE_BROWSER_MODULE=
SOURCE_BROWSER_EXECUTABLE=
MEDI_DISABLED=
