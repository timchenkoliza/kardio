{
  "change_id": "CHG-2026-10-22-agent-mvp-research-slice",
  "cause": "code",
  "status": "IN_PROGRESS",
  "title": "Agent MVP: one configured research scenario, a named publication review and one compact evidence answer",
  "problem": {
    "user_segment": "physicians across the six launch specialties",
    "job": "understand what studies show on a question or in one named article, check it against the primary source",
    "observed_failure": "The home shortcut and the gallery opened the bare input without the scenario settings; the input ran research without settings or structured reading; a pasted PMID went to the reference answer; the research result stacked a trust panel, an English summary, a 14-row table, export and nine cards with the same decorative art (10 749 px at 390); Lancet decimals were read as «HR 0»; intervals from another sentence were glued to a ratio; a full patient name was masked only partly; an acute patient state was not stopped.",
    "evidence": [
      "docs/agent-mvp/DECISION.md",
      "docs/agent-mvp/screens/current/research-result-390.jpg",
      "lib/agents/research-study-normalization.ts: effect regex without the middle dot",
      "server/agents/services/risk.ts: PATIENT_NAME masked one word",
      "server/agents/research-run.ts: called only from /api/agents/research"
    ]
  },
  "hypothesis": "If the research scenario has one door with its real settings, one execution, a review of a named publication and one compact answer whose numbers are quoted from the article, physicians can verify a study faster and return to the scenario.",
  "target_metric": {
    "name": "qualified_repeat_use_after_value_session",
    "desired_direction": "increase"
  },
